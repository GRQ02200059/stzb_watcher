<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.MyApplication" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/glacier_blue_500</item>
        <item name="colorPrimaryVariant">@color/glacier_blue_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/ink_secondary</item>
        <item name="colorSecondaryVariant">@color/glacier_blue_700</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/glacier_blue_50</item>
        <item name="android:navigationBarColor">@color/glacier_blue_50</item>
        <item name="android:fontFamily">sans</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowNoTitle">true</item>
        <!-- Customize your theme here. -->
    </style>
</resources>
